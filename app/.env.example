# ============================================================
# Lead Gen Motor — Variáveis de Ambiente
# Copie para .env e preencha com seus valores reais
# NUNCA commite o .env no Git
# ============================================================

# --- Aplicação ---
APP_PORTA=8080
APP_AMBIENTE=prod       # prod (JSON logs) | dev (logs texto)

# --- Banco de Dados ---
DB_HOST=postgres         # nome do container no docker-compose
DB_PORTA=5432
DB_NOME=leadgen
DB_USUARIO=leadgen
DB_SENHA=TROQUE_ESTA_SENHA_FORTE   # mínimo 16 chars
DB_SSLMODE=disable        # disable dentro do Docker; require em produção com certificado
DB_MAX_CONNS=10
DB_MAX_IDLE=5

# --- AWS ---
AWS_REGION=us-east-1

# --- Amazon SES (Email) ---
# 1. Verifique seu email/domínio no console SES
# 2. Solicite saída do sandbox para enviar para qualquer email
SES_REMETENTE_EMAIL=seuemail@dominio.com
SES_REMETENTE_NOME=Lead Gen Motor

# --- WhatsApp Business API (Meta) ---
# Obtenha em: https://developers.facebook.com/apps
# 1. Crie um App Business
# 2. Adicione WhatsApp Business API
# 3. Gere o token de acesso permanente
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Chrome Headless (para redes sociais) ---
CHROME_URL=ws://chromedp:9222
CHROME_DELAY_MIN_MS=500    # delay mínimo entre ações (anti-detecção)
CHROME_DELAY_MAX_MS=2000   # delay máximo

# --- LinkedIn (automação) ---
# AVISO: Use conta dedicada para prospecção, NÃO sua conta pessoal
LINKEDIN_USER=
LINKEDIN_PASS=

# --- Instagram (automação) ---
INSTAGRAM_USER=
INSTAGRAM_PASS=

# --- Facebook (automação) ---
FACEBOOK_USER=
FACEBOOK_PASS=

# --- Notificação (SMS para o closer) ---
# Número no formato E.164: +5511999999999
SNS_NUMERO_CLOSER=+55119XXXXXXXX
SNS_NOME_DISPLAY=LeadGen  # até 11 chars

# --- Arquivo de Limites ---
LIMITS_FILE=/app/config/limits.yaml
