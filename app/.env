# ============================================================
# Lead Gen Motor — Variáveis de Ambiente
# NUNCA commite este arquivo no Git
# ============================================================

# --- Aplicação ---
APP_PORTA=8080
APP_AMBIENTE=prod        # prod (JSON logs) | dev (logs texto)

# --- Banco de Dados ---
DB_HOST=postgres          # nome do container no docker-compose
DB_PORTA=5432
DB_NOME=leadgen
DB_USUARIO=leadgen
DB_SENHA=Leadgen@2024!Forte   # troque para senha forte antes de ir a produção
DB_SSLMODE=disable            # disable dentro do Docker; require em prod com certificado
DB_MAX_CONNS=10
DB_MAX_IDLE=5

# --- AWS ---
# No AWS Academy: exporte as credenciais do painel "AWS Details" antes de subir
# export AWS_ACCESS_KEY_ID=ASIA...
# export AWS_SECRET_ACCESS_KEY=...
# export AWS_SESSION_TOKEN=...
AWS_REGION=us-east-1

# --- Amazon SES (Email) ---
# 1. No console AWS > SES > Verified identities: verifique seu email ou domínio
# 2. Solicite saída do Sandbox (AWS Support) para enviar para qualquer endereço
# 3. Preencha abaixo com o email/domínio verificado
SES_REMETENTE_EMAIL=seuemail@seudominio.com
SES_REMETENTE_NOME=Lead Gen Motor

# --- WhatsApp Business API (Meta) ---
# Como obter:
#   1. Acesse developers.facebook.com > Meus Apps > Criar App > Business
#   2. Adicione o produto "WhatsApp"
#   3. Em WhatsApp > Configuração: copie o Phone Number ID e gere o Token
#   4. Para token permanente: Business Settings > System Users > gerar token com permissões
#      whatsapp_business_messaging e whatsapp_business_management
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=1234567890123456

# --- Chrome Headless (para redes sociais via chromedp) ---
CHROME_URL=ws://chromedp:9222
CHROME_DELAY_MIN_MS=800     # delay mínimo entre ações (ms) — anti-detecção
CHROME_DELAY_MAX_MS=2500    # delay máximo entre ações (ms)

# --- LinkedIn (automação via chromedp) ---
# AVISO: Use conta dedicada para prospecção — NUNCA sua conta pessoal
# Risco de bloqueio se automatizar excessivamente. Use rate limits conservadores.
LINKEDIN_USER=seu.email@linkedin.com
LINKEDIN_PASS=SuaSenhaLinkedIn

# --- Instagram (automação via chromedp) ---
# AVISO: Use conta business dedicada para prospecção
INSTAGRAM_USER=seu_usuario_instagram
INSTAGRAM_PASS=SuaSenhaInstagram

# --- Facebook (automação via chromedp) ---
# AVISO: Use página/perfil business dedicado para prospecção
FACEBOOK_USER=seu.email@facebook.com
FACEBOOK_PASS=SuaSenhaFacebook

# --- Notificação SMS (Amazon SNS → closer) ---
# Número do vendedor que será alertado quando lead ficar "quente" (score >= 60)
# Formato E.164: +5511999999999 (código país + DDD + número)
SNS_NUMERO_CLOSER=+5511999999999
SNS_NOME_DISPLAY=LeadGen     # aparece como remetente no SMS (máx 11 chars)

# --- Arquivo de Limites de Rate ---
LIMITS_FILE=/app/config/limits.yaml
